# Generated by scripts/configure.py from docs-kit.yml. The leading slash
# limits each entry to the repository root, so the packs' own test
# configs are kept.
/.vale.ini
/.codespellrc
/.lychee.toml
/.docs-kit/

# Copy of the built site made by the link check.
/_linkroot/

# Doc Detective results.
.github/doc-detective/results/

# MkDocs build output.
/site/
